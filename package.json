{
  "name": "boston-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A photoreal, real-time 3D model of Boston built from OpenStreetMap (ODbL) + USGS elevation data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview --port 4173",
    "data": "node tools/build-data.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rollup/pluginutils": "^5.4.0",
    "@types/three": "^0.169.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-glsl": "^1.3.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "three": "^0.169.0"
  }
}
